<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>TitlebarButtonSmoke</AssemblyName>
    <TitlebarPublishDirectory Condition="'$(TitlebarPublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\1Remote</TitlebarPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="1Remote"><HintPath>$(TitlebarPublishDirectory)\1Remote.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(TitlebarPublishDirectory)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Dragablz"><HintPath>$(TitlebarPublishDirectory)\Dragablz.dll</HintPath></Reference>
    <Reference Include="Shawn.Utils"><HintPath>$(TitlebarPublishDirectory)\Shawn.Utils.dll</HintPath></Reference>
    <Reference Include="Shawn.Utils.Wpf"><HintPath>$(TitlebarPublishDirectory)\Shawn.Utils.Wpf.dll</HintPath></Reference>
    <Reference Include="Shawn.Utils.WpfResources"><HintPath>$(TitlebarPublishDirectory)\Shawn.Utils.WpfResources.dll</HintPath></Reference>
    <Reference Include="Stylet"><HintPath>$(TitlebarPublishDirectory)\Stylet.dll</HintPath></Reference>
  </ItemGroup>
</Project>
